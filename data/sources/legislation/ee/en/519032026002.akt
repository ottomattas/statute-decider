			<pealkiri id="beb54fba-fbbb-4cf3-a713-64efa400c4f3">Personal Data Protection Act</pealkiri>
			<normtehnmarkus id="29cde315-f9e8-4fcd-b342-36dd58f091e6" kuuluvus="KUULUVUS_011b38a5-e413-41a5-ab38-fd9d9bd984ee">
