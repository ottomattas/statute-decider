			<RTosa>RT I</RTosa>
			<avaldamineKuupaev>2024-12-30</avaldamineKuupaev>
			<RTartikkel>1</RTartikkel>
			<aktViide>130122024001</aktViide>
		</avaldamismarge>
		<joustumine>2025-01-01</joustumine>
	</muutmismarge>
	<muutmismarge>
		<aktikuupaev>2024-12-11</aktikuupaev>
		<avaldamismarge>
			<RTosa>RT I</RTosa>
			<avaldamineKuupaev>2025-01-09</avaldamineKuupaev>
			<RTartikkel>1</RTartikkel>
			<aktViide>109012025001</aktViide>
		</avaldamismarge>
		<joustumine>2025-09-01</joustumine>
	</muutmismarge>
	<muutmismarge>
