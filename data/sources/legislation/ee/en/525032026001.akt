			<avaldamineKuupaev>2023-03-07</avaldamineKuupaev>
			<RTartikkel>2</RTartikkel>
			<aktViide>107032023002</aktViide>
		</avaldamismarge>
		<joustumine>2023-05-01</joustumine>
	</muutmismarge>
	<muutmismarge>
