				<paragrahv id="para140">
					<paragrahvNr>140</paragrahvNr>
					<kuvatavNr><![CDATA[§ 140.]]></kuvatavNr>
					<paragrahvPealkiri>Ebaseaduslik tegevus ehitise kaitsevööndis</paragrahvPealkiri>
					<loige id="para140lg1">
						<loigeNr>1</loigeNr>
						<kuvatavNr><![CDATA[(1)]]></kuvatavNr>
						<sisuTekst>
							<tavatekst>Nõuetele mittevastava tegevuse korral ehitise kaitsevööndis, kui sellega kaasneb oht inimese elule, tervisele, varale või keskkonnale, –<reavahetus/>karistatakse rahatrahviga kuni 300 trahviühikut.</tavatekst>
						</sisuTekst>
					</loige>
					<loige id="para140lg2">
						<loigeNr>2</loigeNr>
						<kuvatavNr><![CDATA[(2)]]></kuvatavNr>
						<sisuTekst>
							<tavatekst>Sama teo eest, kui selle on toime pannud juriidiline isik, –<reavahetus/>karistatakse rahatrahviga kuni 100 000 eurot.</tavatekst>
						</sisuTekst>
						<muutmismarge>
							<avaldamismarge>
								<RTosa>RT I</RTosa>
								<avaldamineKuupaev>2022-04-27</avaldamineKuupaev>
								<RTartikkel>1</RTartikkel>
								<aktViide>127042022001</aktViide>
							</avaldamismarge>
							<joustumine>2022-05-07</joustumine>
						</muutmismarge>
					</loige>
				</paragrahv>
				<paragrahv id="para141">
					<paragrahvNr>141</paragrahvNr>
					<kuvatavNr><![CDATA[§ 141.]]></kuvatavNr>
					<paragrahvPealkiri>Menetlus</paragrahvPealkiri>
					<loige id="para141lg1">
						<loigeNr/>
						<kuvatavNr/>
						<sisuTekst>
							<tavatekst>Käesoleva seadustiku §-des 134–140 sätestatud väärtegude kohtuväline menetleja on vastavalt oma pädevusele:</tavatekst>
						</sisuTekst>
						<alampunkt id="para141lg1p1">
							<alampunktNr>1</alampunktNr>
							<kuvatavNr><![CDATA[1)]]></kuvatavNr>
							<sisuTekst>
								<tavatekst>linna- või vallavalitsus;</tavatekst>
							</sisuTekst>
						</alampunkt>
						<alampunkt id="para141lg1p2">
							<alampunktNr>2</alampunktNr>
							<kuvatavNr><![CDATA[2)]]></kuvatavNr>
							<sisuTekst>
								<tavatekst>Tarbijakaitse ja Tehnilise Järelevalve Amet;</tavatekst>
							</sisuTekst>
						</alampunkt>
						<alampunkt id="para141lg1p3">
							<alampunktNr>3</alampunktNr>
							<kuvatavNr><![CDATA[3)]]></kuvatavNr>
							<sisuTekst>
								<tavatekst>Keskkonnaamet;</tavatekst>
							</sisuTekst>
							<muutmismarge>
