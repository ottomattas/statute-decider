								<aktViide>104122024001</aktViide>
							</avaldamismarge>
							<joustumine>2025-01-01</joustumine>
						</muutmismarge>
					</loige>
				</paragrahv>
				<paragrahv id="para61">
					<paragrahvNr>61</paragrahvNr>
					<kuvatavNr><![CDATA[§ 61.]]></kuvatavNr>
					<paragrahvPealkiri>Ehitisregistri andmete tähendus</paragrahvPealkiri>
					<loige id="para61lg1">
						<loigeNr>1</loigeNr>
						<kuvatavNr><![CDATA[(1)]]></kuvatavNr>
						<sisuTekst>
							<tavatekst>Ehitisregistri andmetel on informatiivne ja statistiline tähendus.</tavatekst>
						</sisuTekst>
					</loige>
					<loige id="para61lg2">
						<loigeNr>2</loigeNr>
						<kuvatavNr><![CDATA[(2)]]></kuvatavNr>
						<sisuTekst>
							<tavatekst>Taotlustel, projekteerimistingimustel, teatistel, hoonestus-, ehitus- ja kasutusloal, ettekirjutustel ning käesoleva seadustiku § 82<sup>2</sup> lõigetes 4 ja 5 nimetatud otsustel on õiguslik tähendus.</tavatekst>
						</sisuTekst>
						<muutmismarge>
							<avaldamismarge>
								<RTosa>RT I</RTosa>
								<avaldamineKuupaev>2025-11-21</avaldamineKuupaev>
								<RTartikkel>1</RTartikkel>
								<aktViide>121112025001</aktViide>
							</avaldamismarge>
							<joustumine>2026-05-12</joustumine>
						</muutmismarge>
					</loige>
				</paragrahv>
			</peatykk>
